# Supabase (Settings → API Keys). A chave publicável pode ir para o navegador: o RLS protege os dados.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL pública do app (usada no redirect do login). Em dev pode ficar vazia.
NEXT_PUBLIC_SITE_URL=

# Só no servidor. Necessárias para a sincronização com o GitHub.
SUPABASE_SECRET_KEY=
GITHUB_TOKEN=
# Opcional: o segredo do agendador já fica no Vault do Supabase (verify_cron_secret).
CRON_SECRET=

# Apenas para o Supabase local (supabase start): OAuth App de desenvolvimento.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
